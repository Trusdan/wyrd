{
  "dirs": [
    "res://tests/unit",
    "res://tests/fake_host",
    "res://tests/golden",
    "res://tests/scenario",
    "res://tests/determinism"
  ],
  "include_subdirs": true,
  "prefix": "test_",
  "suffix": ".gd",
  "should_exit": true,
  "should_exit_on_success": true,
  "ignore_pause": true,
  "log_level": 1,
  "hide_orphans": false,
  "compact_mode": true,
  "double_strategy": "script_only"
}
