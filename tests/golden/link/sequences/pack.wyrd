language 1

events
  bell_rung(count: int)
  season_changed()

sequence harbor.ordered ordered within 1 h reset on season_changed
  on bell_rung where event.count >= 1

sequence harbor.any any(1 of 2) within 1 d reset on filled(ferry)
  on bell_rung where event.count >= 1
  on season_changed where true
