// Gullhaven-named tag-lines golden. Untagged on purpose.
language 1

scene dock.crate_talk
  when player.coins >= 2: ferry: Two coins, and the boat will cross. #line:3d5a
  tavern: The crate waits. {holder(tavern)|variants} #line:ac85
    variant tavern: Still waiting on the dock. #line:440f
  * [Lift the crate] -> lifted #line:048a
    check strength(weight: 2) on_fail -> dropped
  - (lifted)

storylet dock_voice_crossing
  scope: topic rumor.crossing
  speaker: narrator
  - The crossing stays open. {holder(ferry)|variants} #line:773e
    variant ferry: The ferry master keeps the crossing open. #line:8229

document ferry_schedule "Ferry Schedule" #line:52cb
  text: live
  page
    The ferry leaves when the tide turns. #line:30b3
    when not filled(ferry): The ferry master's chair is empty. #line:bbeb
