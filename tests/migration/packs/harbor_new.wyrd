// [EXAMPLE CONTENT] Harbor ids after the renames. An invented fishing village, not a host game.
language 1

quest ferry_toll "Ferry Toll"
  start when false
  stage arrive
    waits_until false
  stage depart was: offer
    waits_until false

template ferry_job "Ferry Job"
  stage wait
    waits_until false
  stage sign was: hire
    waits_until false

role dock_master was: ferry_master
  scope: world
  visibility: secret
  succession: none
  vacancy: hold

document tide_notice "Harbor Gazette" was: harbor_gazette #line:gazette_title
  text: frozen
  page
    The tide is in. #line:gazette_body

verb settle was: pay
verb pay was: paid
