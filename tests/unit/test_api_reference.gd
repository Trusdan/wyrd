extends GutTest

## The generated API reference matches the snapshot and the stability doc.


const _GENERATED := "Generated by tools/gen_api_docs.sh from the ## doc comments. Do not edit by hand."
const _SECTIONS := {
	"methods": "Methods",
	"signals": "Signals",
	"properties": "Properties",
}


func test_snapshot_pages_match_badges() -> void:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://tests/golden/api/expected/stable_api.json"))
	assert_typeof(parsed, TYPE_DICTIONARY)
	var classes: Dictionary = parsed["classes"]
	for reported in classes.keys():
		var page := _page(str(reported))
		assert_false(page.is_empty(), str(reported))
		var entry: Dictionary = classes[reported]
		var class_experimental := bool(entry["experimental"])
		assert_eq(_class_badge(page) == "Experimental", class_experimental, str(reported))
		for kind in _SECTIONS.keys():
			for row in entry[kind]:
				var member_name := str(row["name"])
				if member_name.begins_with("@"):
					continue
				var found: Dictionary = _member(page, str(_SECTIONS[kind]), member_name)
				assert_true(bool(found["ok"]), "%s.%s" % [str(reported), member_name])
				var experimental := class_experimental or bool(row["experimental"])
				assert_eq(str(found["badge"]) == "Experimental", experimental, "%s.%s" % [str(reported), member_name])


func test_stable_pages_match_stability_doc() -> void:
	var from_doc := _stability_names()
	var from_pages: Array[String] = []
	for file_name in _markdown_files():
		if file_name == "index.md":
			continue
		var page := FileAccess.get_file_as_string("res://docs/api/%s" % file_name)
		if _class_badge(page) == "Stable":
			from_pages.append(file_name.trim_suffix(".md"))
	from_doc.sort()
	from_pages.sort()
	assert_eq(from_pages, from_doc)


func test_stable_members_have_descriptions() -> void:
	for file_name in _markdown_files():
		if file_name == "index.md":
			continue
		var page_name := file_name.trim_suffix(".md")
		var page := FileAccess.get_file_as_string("res://docs/api/%s" % file_name)
		if _class_badge(page) != "Stable":
			continue
		assert_false(_class_description(page).is_empty(), "%s class" % page_name)
		for member in _stable_members(page):
			assert_false(str(member["description"]).strip_edges().is_empty(), "%s.%s" % [page_name, str(member["member"])])


func test_index_links_every_page_and_generated_line() -> void:
	var index := FileAccess.get_file_as_string("res://docs/api/index.md")
	assert_eq(index.split("\n")[0], _GENERATED)
	for file_name in _markdown_files():
		var text := FileAccess.get_file_as_string("res://docs/api/%s" % file_name)
		assert_true(text.contains(_GENERATED), file_name)
		if file_name == "index.md":
			continue
		assert_eq(text.split("\n")[1], _GENERATED, file_name)
		assert_true(index.contains("(%s)" % file_name), file_name)


func test_pages_have_no_raw_bbcode_or_approval() -> void:
	for file_name in _markdown_files():
		var text := FileAccess.get_file_as_string("res://docs/api/%s" % file_name)
		for line in text.split("\n"):
			assert_false(line.to_lower().contains("approv"), "%s: %s" % [file_name, line])
		for needle in ["[/code]", "[method ", "[member ", "[param ", "[signal ", "[constant "]:
			assert_false(text.contains(needle), "%s %s" % [file_name, needle])


func _page(page_name: String) -> String:
	return FileAccess.get_file_as_string("res://docs/api/%s.md" % page_name)


func _markdown_files() -> PackedStringArray:
	var out: PackedStringArray = PackedStringArray()
	var dir := DirAccess.open("res://docs/api")
	assert_not_null(dir)
	dir.list_dir_begin()
	var entry := dir.get_next()
	while entry != "":
		if entry.ends_with(".md"):
			out.append(entry)
		entry = dir.get_next()
	dir.list_dir_end()
	return out


func _stability_names() -> Array[String]:
	var text := FileAccess.get_file_as_string("res://docs/stability.md")
	var inside := false
	var names: Array[String] = []
	for line in text.split("\n"):
		if line.begins_with("## "):
			if inside:
				break
			inside = line == "## Stable surface"
			continue
		if inside and line.begins_with("### "):
			names.append(line.substr(4).strip_edges())
	return names


func _class_badge(page: String) -> String:
	for line in page.split("\n"):
		if line.begins_with("## "):
			return ""
		var badge := _badge(line)
		if not badge.is_empty():
			return badge
	return ""


func _class_description(page: String) -> String:
	var lines := page.split("\n")
	var started := false
	var kept: PackedStringArray = PackedStringArray()
	for line in lines:
		if not started:
			if line.begins_with("Inherits:"):
				started = true
			continue
		if line.begins_with("## "):
			break
		if not line.strip_edges().is_empty():
			kept.append(line.strip_edges())
	return "\n".join(kept)


func _member(page: String, section: String, member_name: String) -> Dictionary:
	var lines := page.split("\n")
	var current := ""
	var index := 0
	while index < lines.size():
		var line := lines[index]
		if line.begins_with("## "):
			current = line.substr(3).strip_edges()
		elif line == "### `%s`" % member_name and current == section:
			var badge := ""
			var cursor := index + 1
			while cursor < lines.size() and badge.is_empty():
				badge = _badge(lines[cursor])
				cursor += 1
			return {"ok": true, "badge": badge, "description": _after_fence(lines, index)}
		index += 1
	return {"ok": false, "badge": "", "description": ""}


func _stable_members(page: String) -> Array[Dictionary]:
	var lines := page.split("\n")
	var found: Array[Dictionary] = []
	var index := 0
	while index < lines.size():
		var line := lines[index]
		if line.begins_with("### `") and line.ends_with("`"):
			var member_name := line.substr(5, line.length() - 6)
			var badge := ""
			var cursor := index + 1
			while cursor < lines.size() and badge.is_empty():
				if lines[cursor].begins_with("## ") or lines[cursor].begins_with("### "):
					break
				badge = _badge(lines[cursor])
				cursor += 1
			if badge == "Stable":
				found.append({"member": member_name, "description": _after_fence(lines, index)})
		index += 1
	return found


func _after_fence(lines: PackedStringArray, heading: int) -> String:
	var index := heading + 1
	var opened := false
	while index < lines.size():
		if not opened and lines[index] == "```gdscript":
			opened = true
		elif opened and lines[index] == "```":
			index += 1
			break
		elif lines[index].begins_with("## ") or lines[index].begins_with("### "):
			return ""
		index += 1
	var kept: PackedStringArray = PackedStringArray()
	while index < lines.size():
		if lines[index].begins_with("## ") or lines[index].begins_with("### "):
			break
		if not lines[index].strip_edges().is_empty():
			kept.append(lines[index].strip_edges())
		index += 1
	return "\n".join(kept)


func _badge(line: String) -> String:
	if line == "**Stable**" or line.begins_with("**Stable**:"):
		return "Stable"
	if line == "**Experimental**" or line.begins_with("**Experimental**:"):
		return "Experimental"
	return ""
