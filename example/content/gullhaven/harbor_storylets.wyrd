// [EXAMPLE CONTENT] Gullhaven storylets. An invented fishing village, not a host game.
language 1

storylet harbor_gossip.generic
  scope: topic rumor.ferry_toll
  speaker: any
  - They say the ferry's dear since the storm. #line:sg01

storylet harbor_gossip.tavern
  scope: topic rumor.ferry_toll
  speaker: tavern
  when: knows(player, harbor.toll_fate) and world.season == autumn
  weight: 2
  cooldown: 60m
  lines:
    - The toll money never reached the council, if you ask me. #line:sg02
    - Lost at sea, they say. Lost in someone's pocket. #line:sg03

storylet dock_bark_lantern
  scope: bark
  speaker: ferry
  when: nearby(player, 4m, tag: lantern) > 0
  cooldown: 30m
  - Mind that flame near the ropes. #line:sg04

storylet dock_bark_lantern_carried
  scope: bark
  speaker: ferry
  when: has(player, lantern) and nearby(player, 4m, tag: lantern) > 0
  speaker_cooldown: 10m
  - That lantern in your hand is close to the ropes. #line:sg05

storylet dock_voice_crossing
  scope: topic rumor.crossing
  speaker: narrator
  - The crossing stays open. {holder(ferry_master)|variants} #tag:voiced #line:dock_voice
    variant ferry_master: The ferry master keeps the crossing open. #tag:voiced #line:dock_voice_master
    variant net_mender: The net mender keeps the crossing open. #tag:voiced #line:dock_voice_mender
