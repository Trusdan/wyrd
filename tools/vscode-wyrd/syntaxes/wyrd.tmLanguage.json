        },
        {
          "include": "#reserved"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#booleans"
        },
        {
          "include": "#blocks"
        }
      ]
    },
    "comment": {
      "match": "//.*",
      "name": "comment.line.double-slash.wyrd"
    },
    "string": {
      "name": "string.quoted.double.wyrd",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\[\"\\\\]",
          "name": "constant.character.escape.wyrd"
        }
      ]
    },
    "tag": {
      "match": "(#(?:line|tag|secrecy):)([A-Za-z0-9_]+)",
      "captures": {
        "1": {
          "name": "entity.name.tag.wyrd"
        },
        "2": {
          "name": "constant.other.wyrd"
        }
      }
    },
    "number": {
      "match": "\\b\\d+(?:\\.\\d+)?(?:[ \\t]*(?:m|h|d|minutes?|hours?|days?))?\\b",
      "name": "constant.numeric.wyrd"
    },
    "divert": {
      "match": "(->)(\\s+)((?:scene\\s+)?[A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "keyword.control.divert.wyrd"
        },
        "3": {
          "name": "entity.name.function.wyrd"
        }
      }
    },
    "escape": {
      "match": "\\{\\{",
      "name": "constant.character.escape.wyrd"
    },
    "interpolation": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.interpolation.wyrd",
      "patterns": [
        {
          "include": "#conditional"
        },
        {
          "match": "(\\|)(variants)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.wyrd"
            },
            "2": {
              "name": "keyword.operator.wyrd"
            }
          }
        },
        {
          "include": "#code"
        }
      ]
    },
    "effect-line": {
      "begin": "^(\\s*)(~)(\\s+)",
      "end": "$",
      "beginCaptures": {
        "2": {
          "name": "keyword.operator.effect.wyrd"
        }
      },
      "patterns": [
        {
          "include": "#effects"
        },
        {
          "include": "#code-inner"
        }
      ]
    },
    "code-inner": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#tag"
        },
        {
          "include": "#number"
        },
        {
          "include": "#divert"
        },
        {
          "include": "#punct"
        },
        {
          "include": "#fields"
        },
        {
          "include": "#states"
        },
        {
          "include": "#outcomes"
        },
        {
          "include": "#reserved"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#booleans"
        },
        {
          "include": "#blocks"
        }
      ]
    },
    "punct": {
      "match": "==|!=|<=|>=|\\.\\.|=|\\+|-|\\*|/|<|>|\\|",
      "name": "keyword.operator.wyrd"
    }
  }
}
