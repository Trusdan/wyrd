  "repository": {
    "header": {
      "match": "\\b(?:language)\\b",
      "name": "keyword.other.header.wyrd"
    },
    "blocks": {
      "match": "\\b(?:facts|events|quest|scene|role|storylet|sequence|document|template)\\b",
      "name": "keyword.other.block.wyrd"
    },
    "reserved": {
      "match": "\\b(?:document|publishes_by|tier|await_host|believe|declare|forget|learn|retract)\\b",
      "name": "keyword.other.reserved.wyrd"
    },
    "types": {
      "match": "\\b(?:bool|int|float|symbol)\\b",
      "name": "storage.type.wyrd"
    },
    "fields": {
      "match": "\\b(?:default_holder|eligibility|scope|succession|vacancy|visibility|cooldown|priority|secrecy|speaker|speaker_cooldown|weight|when|fragment|text|meta|page|on_read|on_first_read|claim|fact|verb|publishes_by|every|delay|stored|source|recap|invalidate|doc|slot|on_empty|start|requires|stage|waits_until|journal|variant|await_host|on|region|redirect|on_abort|on_fail|check|disabled_when|show_disabled_when|ordered|any|where|leaves|decays|mode|live|frozen|cast|locked_at|lines|within|reset|with|topic|quest|role|baseline|copy|deed|to|by|of|beat|event|witnesses|actor|magnitude|memorable|place|statement|tags|target|auto|slant|param|max_active|assumes|allow_protected)\\b",
      "name": "keyword.other.wyrd"
    },
    "effects": {
      "match": "\\b(?:set|inc|record|unlock|lock|do|outcome|believe|unbelieve|declare|retract|learn|forget|start|advance|assign|vacate|adjust|create)\\b",
      "name": "keyword.other.wyrd"
    },
    "states": {
      "match": "\\b(?:default|successor|empty|hostile|locked_gone|contested|unwilling|barred)\\b",
      "name": "keyword.control.wyrd"
    },
    "outcomes": {
      "match": "\\b(?:route_closed|done|failed)\\b",
      "name": "keyword.control.wyrd"
    },
    "operators": {
      "match": "\\b(?:and|or|not|in)\\b",
      "name": "keyword.operator.wyrd"
    },
    "conditional": {
      "match": "\\b(?:if|else|end)\\b",
      "name": "keyword.control.conditional.wyrd"
    },
    "booleans": {
      "match": "\\b(?:true|false)\\b",
      "name": "constant.language.wyrd"
    },
    "code": {
      "patterns": [
        {
          "include": "#effect-line"
        },
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#tag"
        },
        {
          "include": "#number"
